<!-- ISSUE: Hardcoded 5 select options ignoring 101 entries in countries.json and 35 in categories.json. -->
<!-- CORRECTION: Dynamically iterate over countries and categories data arrays in Nunjucks template. -->
<div class="filter-bar">
  <span class="brand-label">FILTER FEED:</span>
  <select id="country-select" onchange="applyFilters()">
    <option value="">All Countries (Global)</option>
    {% for country in countries %}
      <option value="{{ country.iso2 }}">{{ country.country }} ({{ country.iso2 }})</option>
    {% endfor %}
  </select>

  <select id="category-select" onchange="applyFilters()">
    <option value="">All Categories</option>
    {% for cat in categories %}
      <option value="{{ cat.id }}">{{ cat.name }}</option>
    {% endfor %}
  </select>

  <input type="text" id="search-input" placeholder="SEARCH TITLE / HASH..." onkeyup="applyFilters()">
</div>
