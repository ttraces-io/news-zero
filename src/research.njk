<!-- ISSUE: Root-relative asset/navigation links (/assets/..., /news/) return 404 on GitHub Pages subpaths. -->
<!-- CORRECTION: Wrap stylesheets, scripts, and internal routes in Eleventy | url filter for subpath support. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Research Papers — ttraces.io</title>
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  <script src="{{ '/assets/js/app.js' | url }}" defer></script>
</head>
<body>
  <header>
    <a href="{{ '/' | url }}" class="wordmark">ttraces<span>.io</span></a>
    <nav>
      <a href="{{ '/' | url }}">FEED</a>
      <a href="{{ '/news/' | url }}">NEWS</a>
      <a href="{{ '/research/' | url }}" class="active">RESEARCH</a>
      <a href="{{ '/trends/' | url }}">TRENDS</a>
      <a href="{{ '/privacy/' | url }}">PRIVACY</a>
    </nav>
  </header>

  <main>
    <section>
      <span class="brand-label">OPEN ACCESS PAPERS</span>
      <h1 style="margin-top: 8px;">Security Research Registry</h1>

      <div class="route-line"></div>

      <div class="card-grid">
        {% for paper in researchPapers %}
          {% include "paper-card.njk" %}
        {% endfor %}
      </div>
    </section>
  </main>

  <footer>
    <div>TTRACES.IO — BRAND SYSTEM V1.0 · ZERO-TRACKING PUBLIC FEED</div>
  </footer>
</body>
</html>
