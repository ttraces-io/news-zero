{
  "name": "privacy-cyber-news-feed",
  "version": "1.0.0",
  "description": "Privacy-Preserving Cybersecurity News and Research Aggregation Platform",
  "main": "eleventy.config.js",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "npx @11ty/eleventy",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern _site",
    "scout:news": "node scripts/fetch-feeds.mjs --type=news",
    "scout:papers": "node scripts/fetch-feeds.mjs --type=papers",
    "judge": "node scripts/score-content.mjs",
    "validate:sources": "node scripts/validate-sources.mjs",
    "redact": "node scripts/redact-secrets.mjs",
    "update:trends": "node scripts/update-wiki.mjs"
  },
  "keywords": [
    "cybersecurity",
    "threat-intelligence",
    "privacy-first",
    "eleventy",
    "rss",
    "research-papers"
  ],
  "author": "ttraces-io",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "@playwright/test": "^1.42.1",
    "playwright": "^1.42.1"
  }
}
